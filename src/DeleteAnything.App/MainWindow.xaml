<Window x:Class="DeleteAnything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete_Anything — Kilitli Dosya &amp; Klasör Silici"
        Width="780" Height="640" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Entegrasyon Butonları -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗑️ Delete_Anything" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <Border x:Name="AdminBadge" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center" Background="#1E3A8A">
                        <TextBlock x:Name="AdminBadgeText" Text="Standart Yetki" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Arka planda sürekli çalışmaz; sadece sen açtığında veya sağ tıkladığında çalışır."
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnElevate" Content="🛡 Yönetici Olarak Aç" Click="BtnElevate_Click"
                        Background="#334155" Foreground="White" Padding="10,6" Margin="0,0,8,0"
                        BorderThickness="0" Cursor="Hand" ToolTip="Sistem/servis kilitleri ve yeniden başlatmada silme için yönetici yetkisiyle yeniden başlatır"/>
                <Button x:Name="BtnToggleContext" Content="🖱 Sağ Tık Menüsü: Kontrol Ediliyor..." Click="BtnToggleContext_Click"
                        Background="#1E293B" Foreground="White" Padding="10,6" Margin="0,0,8,0"
                        BorderBrush="#475569" BorderThickness="1" Cursor="Hand"/>
                <Button x:Name="BtnShortcut" Content="📌 Masaüstü Kısayolu" Click="BtnShortcut_Click"
                        Background="#1E293B" Foreground="White" Padding="10,6"
                        BorderBrush="#475569" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Sürükle-Bırak ve Dosya/Klasör Ekleme Barı -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📥 Silinecek dosya veya klasörleri buraya sürükleyip bırakın"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Uzun yollar, bozuk isimler (CON, NUL, nokta ile bitenler) ve kilitli öğeler desteklenir."
                               FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📄 Dosya Ekle" Click="BtnAddFiles_Click"
                            Background="#334155" Foreground="White" Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="📁 Klasör Ekle" Click="BtnAddFolder_Click"
                            Background="#334155" Foreground="White" Padding="10,6" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✖ Listeyi Temizle" Click="BtnClearTargets_Click"
                            Background="#1E293B" Foreground="#94A3B8" Padding="8,6" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hedef Yolu Listesi -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,10">
            <ListBox x:Name="LstTargets" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimary}" FontSize="12.5"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Aksiyon Butonları -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnUnlockDelete" Grid.Column="0" Click="BtnUnlockDelete_Click"
                    Background="#10B981" Foreground="#052E16" FontWeight="Bold" FontSize="13"
                    Padding="10,10" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                    ToolTip="Programları kapatmadan sadece dosyanın açık handle kilidini kapatıp siler">
                <TextBlock Text="🔓 Kilidi Aç &amp; Sil (Program Kapanmaz)" TextTrimming="CharacterEllipsis"/>
            </Button>

            <Button x:Name="BtnKillDelete" Grid.Column="1" Click="BtnKillDelete_Click"
                    Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="13"
                    Padding="10,10" Margin="3,0,6,0" BorderThickness="0" Cursor="Hand"
                    ToolTip="Dosyayı tutan programı kapatıp (gerekirse sonlandırıp) zorla siler">
                <TextBlock Text="🛑 Programı Kapat &amp; Zorla Sil" TextTrimming="CharacterEllipsis"/>
            </Button>

            <Button x:Name="BtnRebootDelete" Grid.Column="2" Click="BtnRebootDelete_Click"
                    Background="#F59E0B" Foreground="#1E1B4B" FontWeight="Bold" FontSize="13"
                    Padding="10,10" Margin="3,0,6,0" BorderThickness="0" Cursor="Hand"
                    ToolTip="Hiçbir programı kapatmadan Windows yeniden başlatıldığında silinmek üzere işaretler">
                <TextBlock Text="🔄 Yeniden Başlatmada Sil" TextTrimming="CharacterEllipsis"/>
            </Button>

            <Button x:Name="BtnScanLocks" Grid.Column="3" Click="BtnScanLocks_Click"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold" FontSize="13"
                    Padding="14,10" Margin="3,0,0,0" BorderThickness="0" Cursor="Hand"
                    Content="🔍 Kim Kilitliyor?"/>
        </Grid>

        <!-- Kilitleyen Programlar Tablosu -->
        <Border Grid.Row="4" Background="{StaticResource BgSecondary}" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtLockHeader" Text="🔒 Kilitleyen Programlar (0)" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                <ListBox x:Name="LstLockers" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="#FCA5A5" FontSize="12.5" FontFamily="Consolas"/>
            </Grid>
        </Border>

        <!-- İşlem Günlüğü (Log) -->
        <Border Grid.Row="5" Background="#090D16" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📋 İşlem Özeti &amp; Günlük" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" Margin="2,0,0,4"/>
                <TextBox x:Name="TxtLog" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="#E2E8F0" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Alt Bilgi -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkAutoCloseOnRightClick" Content="Sağ tık ('Delete_Anything ile sil') ile açıldığında otomatik kilidi açıp sil"
                      IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="Hazır" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
